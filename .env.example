# ──────────────────────────────────────────────────────────────
# Elisa'glam&Co — variables d'environnement
# Copiez ce fichier en `.env` et renseignez les valeurs.
# NE JAMAIS commiter le fichier `.env`.
# ──────────────────────────────────────────────────────────────

# URL publique du site (sans slash final). En local : http://localhost:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Secret Payload : chaîne aléatoire longue (ex. `openssl rand -hex 32`)
PAYLOAD_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Base de données
#  - Local (par défaut) : fichier SQLite  → file:./data/elisaglam.db
#  - Production         : PostgreSQL      → postgres://user:motdepasse@hote:5432/elisaglam
DATABASE_URL=file:./data/elisaglam.db

# ── Stockage des images (optionnel, S3 compatible : AWS S3, Cloudflare R2, Scaleway…)
# Si vide, les images sont stockées dans le dossier ./media (dev uniquement).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Paiement
# Prestataire : paydunya | mock (simulation, interdit en production) | none
PAYMENT_PROVIDER=mock
# PayDunya (https://developers.paydunya.com) — clés de l'application (mode test d'abord)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test | live
PAYDUNYA_MODE=test

# ── Emails transactionnels (Resend)
RESEND_API_KEY=
EMAIL_FROM=Elisa'glam&Co <commandes@votre-domaine.com>

# ── Analytics (activés uniquement après consentement cookies)
# Peuvent aussi être saisis depuis l'admin (Réglages du site).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Tests automatisés uniquement (ignoré en production) : désactive la limitation de débit
# DISABLE_RATE_LIMIT=1
